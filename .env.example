# Local demo works without credentials. Copy to .env.local (never commit).
AI_MODE=mock
# Set AI_MODE=openrouter for Nemotron. All provider keys are server-only.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning
# Optional alternative: AI_MODE=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional Firebase browser persistence. All must be correctly configured to enable it.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ENABLE_FIREBASE=false
